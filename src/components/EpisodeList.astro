---
import FormattedDate from '../components/FormattedDate';
import FullPlayButton from '../components/FullPlayButton';
import UFOIllustration from '../components/illustrations/UFOIllustration.astro';
import type { Episode, Show } from '../lib/rss';
import { dasherize } from '../utils/dasherize';
import { formatDuration } from '../utils/formatDuration';

export interface Props {
  episodes: Array<Episode>;
  show: Show;
}

const { episodes } = Astro.props;
---

{
  episodes.length === 0 ? (
    <div class="flex flex-col items-center">
      <div class="h-auto w-full max-w-80">
        <UFOIllustration />
      </div>

      <p class="text-light-text-heading py-10 text-lg font-bold dark:text-white">
        No episodes yet. Check back soon!
      </p>
    </div>
  ) : (
    <section aria-labelledby="past-episodes-heading" class="mt-16 mb-12">
      <h2 id="past-episodes-heading" class="section-heading-underlined">
        これまでのエピソード
      </h2>

      <ul aria-label="EpisodeList">
        {episodes.map((episode) => {
          return (
            <li class="dark:border-dark-border border-b">
              <div class="flex w-full flex-col gap-4 py-6 sm:flex-row sm:items-center sm:gap-8">
                <div class="min-w-0 flex-1 break-words">
                  <p class="flex flex-wrap items-center gap-x-2">
                    <FormattedDate date={new Date(episode.published)} />
                    <span aria-hidden="true" class="section-heading">
                      ・
                    </span>
                    <span class="section-heading">
                      {formatDuration(episode.duration)}
                    </span>
                  </p>

                  <h3 class="text-light-text-heading mt-1 text-base leading-snug font-bold dark:text-white">
                    <a
                      href={`/${episode.episodeSlug}`}
                      style={
                        'view-transition-name: var(--should-vt); --vt-name: vt-' +
                        dasherize(episode.title)
                      }
                    >
                      {episode.episodeNumber}: {episode.title}
                    </a>
                  </h3>

                  <p class="mt-2 line-clamp-2 text-sm leading-relaxed">
                    {episode.description}
                  </p>
                </div>

                <div class="shrink-0 text-sm whitespace-nowrap">
                  <FullPlayButton
                    client:visible
                    episode={{
                      audio: episode.audio,
                      episodeNumber: episode.episodeNumber,
                      id: episode.id,
                      title: episode.title
                    }}
                  />
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  )
}

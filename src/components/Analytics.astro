---
// Google Analytics 4. Rendered only when PUBLIC_GA_ID is provided at build time.
// Page views are sent on `astro:page-load` so client-side View Transitions
// navigations (via <ClientRouter />) are tracked, not just full page loads.
const gaId = import.meta.env.PUBLIC_GA_ID;
---

{
  gaId && (
    <script is:inline define:vars={{ gaId }}>
      if (!window.__gaInit) {
        window.__gaInit = true;

        const s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
        document.head.appendChild(s);

        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        window.gtag('js', new Date());
        window.gtag('config', gaId, { send_page_view: false });

        document.addEventListener('astro:page-load', function () {
          window.gtag('event', 'page_view', {
            page_title: document.title,
            page_location: location.href,
            page_path: location.pathname + location.search
          });
        });
      }
    </script>
  )
}

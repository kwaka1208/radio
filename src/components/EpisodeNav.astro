---
import type { Episode } from '../lib/rss';

export interface Props {
  /** The older episode (one before this one), if any. */
  previous?: Episode;
  /** The newer episode (one after this one), if any. */
  next?: Episode;
}

const { previous, next } = Astro.props;

const cardClass =
  'group border-light-input-border bg-light-input-bg hover:border-light-input-border-focused dark:border-dark-input-border dark:bg-dark-input-bg dark:hover:border-dark-input-border-focused flex h-full flex-col rounded-2xl border p-5 shadow-sm transition-colors';
---

{
  (previous || next) && (
    <nav
      aria-label="前後のエピソード"
      class="dark:border-dark-border mt-16 mb-12 grid gap-4 border-t pt-8 sm:grid-cols-2"
    >
      <div>
        {previous && (
          <a class={cardClass} href={`/${previous.episodeSlug}`} rel="prev">
            <span class="section-heading">← 前のエピソード</span>
            <span class="text-light-text-heading mt-2 line-clamp-2 font-bold dark:text-white">
              {previous.episodeNumber}: {previous.title}
            </span>
          </a>
        )}
      </div>

      <div>
        {next && (
          <a
            class={`${cardClass} sm:items-end sm:text-right`}
            href={`/${next.episodeSlug}`}
            rel="next"
          >
            <span class="section-heading">次のエピソード →</span>
            <span class="text-light-text-heading mt-2 line-clamp-2 font-bold dark:text-white">
              {next.episodeNumber}: {next.title}
            </span>
          </a>
        )}
      </div>
    </nav>
  )
}

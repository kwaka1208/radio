---
import Layout from '../layouts/Layout.astro';
import EpisodeList from '../components/EpisodeList.astro';
import LatestEpisode from '../components/LatestEpisode.astro';
import { getAllEpisodes, getShowInfo } from '../lib/rss';
const episodes = await getAllEpisodes();
const show = await getShowInfo();
const title = `${show.title}`;
const [latest, ...pastEpisodes] = episodes;
---

<Layout title={title}>
  <div class="relative z-10 px-8 lg:px-18">
    <h1 class="text-light-text-heading text-4xl font-bold dark:text-white">
      Episodes
    </h1>

    {
      latest ? (
        <>
          <LatestEpisode episode={latest} show={show} />
          {pastEpisodes.length > 0 && (
            <EpisodeList episodes={pastEpisodes} show={show} />
          )}
        </>
      ) : (
        <EpisodeList episodes={episodes} show={show} />
      )
    }
  </div>
</Layout>
